{
  "manifest_version": 3,
  "name": "PageLens — Website Inspector",
  "short_name": "PageLens",
  "version": "1.0.1",
  "version_name": "1.0.1",
  "description": "Inspect webpage metadata, headings, images, links and JSON-LD locally in one click.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "js/extension/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open PageLens"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
