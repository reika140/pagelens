{
  "manifest_version": 3,
  "name": "PageLens — Website Inspector",
  "short_name": "PageLens",
  "version": "1.3.3",
  "version_name": "1.3.3",
  "description": "Inspect webpage metadata, headings, images, links and JSON-LD locally in one click.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Inspect the current webpage with PageLens",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://google.com/*",
        "https://www.google.com.vn/*",
        "https://google.com.vn/*"
      ],
      "js": [
        "js/extension/google-serp-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
