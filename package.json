{
  "name": "pagelens",
  "version": "1.3.3",
  "private": true,
  "type": "module",
  "description": "Local-first website inspection Chrome extension",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run typecheck && node scripts/lint.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "node scripts/run-python.mjs tests/browser_e2e.py",
    "check": "npm run lint && npm test && npm run verify",
    "package": "npm run check && node scripts/package.mjs",
    "test:ui": "node scripts/run-python.mjs tests/popup_smoke.py",
    "verify": "node scripts/verify-dist.mjs",
    "test:serp": "node scripts/run-python.mjs tests/google_serp_e2e.py",
    "test:auto-serp": "node scripts/run-python.mjs tests/google_auto_e2e.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "reika140 (https://github.com/reika140)",
  "homepage": "https://github.com/reika140/pagelens#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/reika140/pagelens.git"
  },
  "bugs": {
    "url": "https://github.com/reika140/pagelens/issues"
  },
  "keywords": [
    "chrome-extension",
    "website-inspector",
    "seo",
    "developer-tools",
    "manifest-v3",
    "local-first"
  ]
}
